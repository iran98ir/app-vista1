<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- ===== قاب طلایی دور لوگو ===== -->
    <FrameLayout
        android:id="@+id/logoFrame"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/splash_logo_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />
    </FrameLayout>

    <!-- ===== اسم اپ ===== -->
    <TextView
        android:id="@+id/splashAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:shadowColor="#00000000"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/logoFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== خط طلایی جداکننده ===== -->
    <View
        android:id="@+id/splashDivider"
        android:layout_width="100dp"
        android:layout_height="3dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/splash_divider"
        app:layout_constraintTop_toBottomOf="@id/splashAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== متن خوش‌آمد ===== -->
    <TextView
        android:id="@+id/splashWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/splash_welcome"
        android:textColor="#F5F0EB"
        android:textSize="20sp"
        android:letterSpacing="0.02"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/splashDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== ProgressBar نازک طلایی ===== -->
    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="180dp"
        android:layout_height="3dp"
        android:layout_marginTop="56dp"
        android:indeterminate="true"
        android:indeterminateTint="#E8C77A"
        app:layout_constraintTop_toBottomOf="@id/splashWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== متن لودینگ ===== -->
    <TextView
        android:id="@+id/splashLoadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/splash_loading"
        android:textColor="#C8D0DC"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif"
        android:alpha="0.85"
        app:layout_constraintTop_toBottomOf="@id/splashProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== نسخه پایین صفحه ===== -->
    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="v1.4.0"
        android:textColor="#8A92A3"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
