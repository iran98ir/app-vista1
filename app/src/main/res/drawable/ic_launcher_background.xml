<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- پس‌زمینه: گرادیانت طلایی تیره لوکس -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#8B3A52"
                android:centerColor="#B65B72"
                android:endColor="#6B2A40" />
        </aapt:attr>
    </path>

    <!-- افکت شیشه‌ای: هایلایت بالا-چپ -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="22" android:centerY="22"
                android:gradientRadius="95"
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- افکت شیشه‌ای: سایه پایین-راست -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="95" android:centerY="95"
                android:gradientRadius="85"
                android:startColor="#35000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- لبه‌ی شیشه‌ای -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:strokeWidth="2"
        android:strokeColor="#55FFFFFF"
        android:fillColor="#00000000" />

</vector>
