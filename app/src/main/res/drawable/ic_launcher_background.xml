<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== گرادیانت سرمه‌ای تیره ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0A1520"
                android:centerColor="#152238"
                android:endColor="#0A1520"
                android:type="linear" />
        </shape>
    </item>

    <!-- ===== درخشش طلایی مرکزی ===== -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:startColor="#25E8C77A"
                android:centerColor="#0AE8C77A"
                android:endColor="#00E8C77A" />
            <size
                android:width="900dp"
                android:height="900dp" />
        </shape>
    </item>

</layer-list>
